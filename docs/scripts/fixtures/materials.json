  {
    "id": "builtin.image",
    "display_name": "自定义图片",
    "builtin": true,
    "is_dynamic": false,
    "defaults": {
      "height": 64.0,
      "offset_x": 0.0,
      "offset_y": 0.0,
      "path": "",
      "scale": 1.0,
      "width": 64.0
    },
    "schema": [
      {
        "key": "path",
        "label": "图片路径",
        "widget": "image_path"
      },
      {
        "key": "scale",
        "label": "缩放",
        "max": 50.0,
        "min": 0.1,
        "step": 0.1,
        "widget": "slider"
      },
      {
        "key": "offset_x",
        "label": "水平偏移",
        "max": 1920.0,
        "min": -1920.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "key": "offset_y",
        "label": "垂直偏移",
        "max": 1920.0,
        "min": -1920.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "key": "width",
        "label": "原始宽度（显示用）",
        "max": 2000.0,
        "min": 1.0,
        "step": 1.0,
        "widget": "number"
      },
      {
        "key": "height",
        "label": "原始高度（显示用）",
        "max": 2000.0,
        "min": 1.0,
        "step": 1.0,
        "widget": "number"
      }
    ]
  },
  {
    "id": "builtin.time",
    "display_name": "时间显示",
    "builtin": true,
    "is_dynamic": true,
    "defaults": {
      "font_size": 24.0,
      "x": 960.0,
      "y": 540.0,
      "format": "HH:mm:ss",
      "bold": false
    },
    "schema": [
      {
        "key": "font_size",
        "label": "字体大小",
        "widget": "slider",
        "min": 8.0,
        "max": 200.0,
        "step": 1.0
      },
      {
        "key": "x",
        "label": "X 坐标",
        "widget": "number",
        "min": 0.0,
        "max": 4000.0,
        "step": 1.0
      },
      {
        "key": "y",
        "label": "Y 坐标",
        "widget": "number",
        "min": 0.0,
        "max": 4000.0,
        "step": 1.0
      },
      {
        "key": "format",
        "label": "展示格式（如 HH:mm:ss / yyyy-MM-dd HH:mm:ss）",
        "widget": "text"
      },
      {
        "key": "bold",
        "label": "加粗",
        "widget": "toggle"
      }
    ]
