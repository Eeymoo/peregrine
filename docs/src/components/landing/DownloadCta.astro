---
/**
 * 下载入口（落地页收尾区块）
 *
 * Windows 三架构入口 + GitHub Releases 总入口。
 * 三架构按钮指向站内下载页（/download，决策 D5），由下载页承接架构选择与加速通道，
 * 不再直链 GitHub 资产（此前 latest/download/ 精确匹配产物名带版本号，全部 404）。
 * 图标来自 lucide-static（与主应用 lucide-react 同源）。文案由 MDX 以 props 传入。
 */
import { lucideIcon } from '../../lib/icons';
import { localeBase } from '../../lib/locale';

interface Props {
  /** 副标题说明（如"Windows 10/11，NSIS 安装包"）。 */
  note: string;
  /** 架构按钮标签前缀（如 "Download for"）。 */
  label: string;
  /** Releases 总入口文字。 */
  releasesText: string;
}

const { note, label, releasesText } = Astro.props;

/** GitHub Releases 总入口（外链保留）。 */
const RELEASES = 'https://github.com/eeymoo/peregrine/releases';
/** 站内下载页路径（按当前 locale 适配双语；localeBase 内部处理了非 Starlight 渲染上下文）。 */
const locale = localeBase(Astro);
const downloadPage = locale ? `/${locale}/download` : '/download';
const artifacts = [
  { arch: 'x64', href: downloadPage },
  { arch: 'x86', href: downloadPage },
  { arch: 'ARM64', href: downloadPage },
];
const downloadIcon = lucideIcon('Download');
---

<div class="dl-block not-content" data-pagefind-ignore>
  <div class="dl-buttons">
    {
      artifacts.map((a) => (
        <a class="dl-button" href={a.href}>
          <span class="dl-icon" aria-hidden="true" set:html={downloadIcon} />
          {label} {a.arch}
        </a>
      ))
    }
  </div>
  <p class="dl-note">
    {note}
    <a class="dl-releases" href={RELEASES} rel="noopener">{releasesText}</a>
  </p>
</div>

<style>
  .dl-block {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 2.5rem;
    text-align: center;
  }

  .dl-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .dl-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.375rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-hairline);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--sl-color-white);
    background: var(--sl-color-bg-sidebar);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }

  .dl-button:hover {
    border-color: color-mix(in srgb, var(--color-accent-500) 55%, transparent);
    transform: translateY(-1px);
  }

  .dl-button:active {
    transform: translateY(0);
  }

  .dl-button .dl-icon {
    display: inline-flex;
    color: var(--sl-color-text-accent);
  }

  .dl-button .dl-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .dl-note {
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
  }

  .dl-releases {
    margin-inline-start: 0.375rem;
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--sl-color-text-accent) 40%, transparent);
  }

  .dl-releases:hover {
    text-decoration-color: var(--sl-color-text-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .dl-button {
      transition: none;
    }
    .dl-button:hover {
      transform: none;
    }
  }
</style>
