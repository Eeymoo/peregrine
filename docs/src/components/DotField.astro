---
/**
 * DotField —— 落地页点阵动态背景（aukcraft 壳层签名组件，D5）
 *
 * 复用 .agents/skills/aukcraft-site-design 资产，改造点：
 * - 光标附近点阵填色由 teal 改为品牌蓝 rgb(37, 99, 235)（blue-600 #2563EB）；
 * - 空心环明暗两种变体：暗色用亮环 rgba(237,237,237,.05)，浅色用深环
 *   rgba(17,21,26,.06)；
 * - 监听 <html data-theme> 变化（MutationObserver）重建 baseLayer——主题切换后
 *   点阵颜色立即正确，不等 resize（skill 原实现仅在 resize 时重建）；
 * - prefers-reduced-motion 下只画静态空心环，不跟随光标；
 * - 画布 z 层位经 --z-field token（-1），低于 Starlight 内容/侧栏、高于页面底色；
 *   pointer-events-none 不拦截交互。
 * 仅挂载于双语 index.mdx（guide 页 / download 页不挂，D5/D10）。
 */
---

<canvas
  id="dot-field"
  class="pointer-events-none fixed inset-0 z-(--z-field) h-full w-full"
  aria-hidden="true"></canvas>

<script>
  const field = document.getElementById('dot-field');
  if (field instanceof HTMLCanvasElement) {
    const ctx = field.getContext('2d');
    if (ctx) {
      /** 品牌蓝 #2563EB（blue-600）：光标附近点阵填色。 */
      const BLUE = '37, 99, 235';
      /** 空心环：暗色亮环 / 浅色深环。 */
      const RING_DARK = 'rgba(237, 237, 237, 0.05)';
      const RING_LIGHT = 'rgba(17, 21, 26, 0.06)';
      const GAP = 30;
      const DOT_R = 1.6;
      const CURSOR_R = 130;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      let dots = [];
      let baseLayer = null;
      let w = 0;
      let h = 0;
      let raf = 0;
      const mouse = { x: -1e4, y: -1e4 };
      const eased = { x: -1e4, y: -1e4 };

      const isLight = () => document.documentElement.dataset.theme === 'light';

      function build() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth;
        h = window.innerHeight;
        field.width = Math.round(w * dpr);
        field.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        dots = [];
        for (let y = GAP / 2; y < h; y += GAP) {
          for (let x = GAP / 2; x < w; x += GAP) {
            dots.push({ x, y });
          }
        }

        baseLayer = document.createElement('canvas');
        baseLayer.width = field.width;
        baseLayer.height = field.height;
        const bctx = baseLayer.getContext('2d');
        if (!bctx) return;
        bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        bctx.strokeStyle = isLight() ? RING_LIGHT : RING_DARK;
        bctx.lineWidth = 1;
        for (const d of dots) {
          bctx.beginPath();
          bctx.arc(d.x, d.y, DOT_R, 0, Math.PI * 2);
          bctx.stroke();
        }
        draw();
      }

      function draw() {
        raf = 0;
        if (!baseLayer) return;
        ctx.clearRect(0, 0, w, h);
        ctx.drawImage(baseLayer, 0, 0, w, h);

        eased.x += (mouse.x - eased.x) * 0.18;
        eased.y += (mouse.y - eased.y) * 0.18;

        if (eased.x > -9999) {
          for (const d of dots) {
            const fill = Math.max(0, 1 - Math.hypot(d.x - eased.x, d.y - eased.y) / CURSOR_R);
            if (fill > 0.04) {
              ctx.fillStyle = `rgba(${BLUE}, ${(fill * 0.55).toFixed(3)})`;
              ctx.beginPath();
              ctx.arc(d.x, d.y, DOT_R + fill * 1.2, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }

        // 光标尾迹未收敛前持续缓动，收敛后休眠。
        if (Math.abs(mouse.x - eased.x) > 0.5 || Math.abs(mouse.y - eased.y) > 0.5) {
          raf = requestAnimationFrame(draw);
        }
      }

      if (!reduceMotion.matches) {
        window.addEventListener(
          'pointermove',
          (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
            if (!raf) raf = requestAnimationFrame(draw);
          },
          { passive: true },
        );
        document.addEventListener('mouseleave', () => {
          mouse.x = -1e4;
          mouse.y = -1e4;
        });
      }

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(build, 150);
      });

      // 主题切换后立即重建 baseLayer（空心环明暗变体），不等 resize。
      new MutationObserver((records) => {
        if (records.some((m) => m.attributeName === 'data-theme')) build();
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      build();
    }
  }
</script>
