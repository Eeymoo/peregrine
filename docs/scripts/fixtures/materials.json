      },
      {
        "key": "left_count",
        "label": "左边球数",
        "max": 20,
        "min": 0,
        "step": 1,
        "widget": "slider"
      },
      {
        "key": "right_count",
        "label": "右边球数",
        "max": 20,
        "min": 0,
        "step": 1,
        "widget": "slider"
      }
    ]
  },
  {
    "id": "builtin.cross",
