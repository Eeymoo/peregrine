---
/**
 * 三步上手（落地页区块）
 *
 * 动词命名（下载 / 选择窗口 / 调整样式），不加 "Step N" 前缀；
 * 大号序号仅作视觉节奏，非阅读内容。文案由 MDX 以 props 传入。
 */
interface Step {
  title: string;
  details: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="hw-grid not-content" data-pagefind-ignore>
  {
    steps.map((step, i) => (
      <li class="hw-step">
        <span class="hw-index" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="hw-title">{step.title}</h3>
        <p class="hw-details">{step.details}</p>
      </li>
    ))
  }
</ol>

<style>
  .hw-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  @media (min-width: 64rem) {
    .hw-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .hw-step {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 1.25rem;
  }

  .hw-index {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--sl-color-text-accent);
    font-variant-numeric: tabular-nums;
  }

  .hw-title {
    margin: 0.5rem 0 0.375rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .hw-details {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }
</style>
