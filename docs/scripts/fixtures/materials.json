        "max": 1920.0,
        "min": 4.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "default": "top",
        "key": "anchor",
        "label": "位置",
        "options": [
          {
            "label": "顶部",
            "value": "top"
          },
          {
            "label": "底部",
            "value": "bottom"
          },
          {
            "label": "左侧",
            "value": "left"
          },
          {
            "label": "右侧",
            "value": "right"
          },
          {
            "label": "中心",
            "value": "center"
          }
