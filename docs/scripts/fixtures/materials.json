      },
      {
        "key": "tail_bottom",
        "label": "下尾巴长度",
        "max": 1920.0,
        "min": 0.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "key": "tail_left",
        "label": "左尾巴长度",
        "max": 1920.0,
        "min": 0.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "key": "tail_right",
        "label": "右尾巴长度",
        "max": 1920.0,
        "min": 0.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "bitmask": true,
        "key": "positions_mask",
        "label": "启用边缘",
        "max": 15,
        "min": 0,
        "step": 1,
        "widget": "number"
      }
