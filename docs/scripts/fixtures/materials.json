[
  {
    "id": "builtin.random_orb",
    "display_name": "随机球",
    "builtin": true,
    "is_dynamic": false,
    "defaults": {
      "center_deviation": 0.2,
      "jitter": 30.0,
      "mode": "lock_on_start",
      "offset": 80.0,
      "orb_count": 3,
      "radius_max": 10.0,
      "radius_min": 4.0
    },
    "schema": [
      {
        "key": "orb_count",
        "label": "每边球数",
        "max": 20,
        "min": 1,
        "step": 1,
        "widget": "slider"
      },
      {
        "key": "offset",
        "label": "距边缘距离",
        "max": 1920.0,
        "min": 0.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "key": "jitter",
        "label": "随机扰动",
        "max": 1920.0,
        "min": 0.0,
        "step": 1.0,
        "widget": "slider"
      },
      {
        "key": "radius_min",
        "label": "最小半径",
        "max": 500.0,
        "min": 1.0,
        "step": 0.5,
        "widget": "slider"
      },
      {
        "key": "radius_max",
        "label": "最大半径",
        "max": 500.0,
        "min": 1.0,
        "step": 0.5,
        "widget": "slider"
      },
      {
        "key": "center_deviation",
        "label": "中心偏离",
        "max": 0.3,
        "min": 0.1,
        "step": 0.01,
        "widget": "slider"
      },
      {
        "coming_soon": true,
        "default": "lock_on_start",
        "key": "mode",
        "label": "模式（开发中）",
        "options": [
          {
            "label": "锁定随机位置",
            "value": "lock_on_start"
          },
          {
            "label": "每次重新随机",
            "value": "reshuffle"
          }
        ],
        "widget": "select"
      }
    ]
  },
  {
    "id": "builtin.ring",
    "display_name": "中心环",
    "builtin": true,
    "is_dynamic": false,
    "defaults": {
      "ring_radius_pct": 0.06,
      "ring_style": "solid",
      "thickness": 2.0
    },
    "schema": [
      {
        "key": "thickness",
        "label": "粗细",
        "max": 50.0,
        "min": 0.5,
        "step": 0.5,
        "widget": "slider"
      },
      {
        "key": "ring_radius_pct",
        "label": "半径占比",
        "max": 0.08,
        "min": 0.03,
        "step": 0.005,
        "widget": "slider"
      },
      {
        "default": "solid",
        "key": "ring_style",
        "label": "线型",
        "options": [
          {
            "label": "实线",
            "value": "solid"
          },
          {
            "label": "虚线",
            "value": "dashed"
          },
          {
            "label": "双环",
            "value": "double"
          }
        ],
        "widget": "select"
      }
    ]
  },
  {
    "id": "builtin.custom_orb",
