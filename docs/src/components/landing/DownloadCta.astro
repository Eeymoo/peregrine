---
/**
 * 下载入口（落地页收尾区块）
 *
 * Windows 三架构入口 + GitHub Releases 总入口。
 * 三架构按钮指向站内下载页（/download，决策 D5），由下载页承接架构选择与加速通道，
 * 不再直链 GitHub 资产（此前 latest/download/ 精确匹配产物名带版本号，全部 404）。
 * 图标来自 lucide-static（与主应用 lucide-react 同源）。文案由 MDX 以 props 传入。
 *
 * 样式为 Tailwind 工具类（twcss-migration change）；现代化项：
 * 1. CTA 架构词改 mono 微标签形态（uppercase + 宽字距，D10 签名元素 2）；
 * 2. CTA :active 下压触感（hover -1px 浮起 → active 归位，motion-reduce 塌缩）。
 */
import { lucideIcon } from '../../lib/icons';
import { localeBase } from '../../lib/locale';

interface Props {
  /** 副标题说明（如"Windows 10/11，NSIS 安装包"）。 */
  note: string;
  /** 架构按钮标签前缀（如 "Download for"）。 */
  label: string;
  /** Releases 总入口文字。 */
  releasesText: string;
}

const { note, label, releasesText } = Astro.props;

/** GitHub Releases 总入口（外链保留）。 */
const RELEASES = 'https://github.com/eeymoo/peregrine/releases';
/** 站内下载页路径（按当前 locale 适配双语；localeBase 内部处理了非 Starlight 渲染上下文）。 */
const locale = localeBase(Astro);
const downloadPage = locale ? `/${locale}/download` : '/download';
const artifacts = [
  { arch: 'x64', href: downloadPage },
  { arch: 'x86', href: downloadPage },
  { arch: 'ARM64', href: downloadPage },
];
const downloadIcon = lucideIcon('Download');
---

<div class="dl-block not-content border-t border-(--sl-color-hairline) pt-10 text-center" data-pagefind-ignore>
  <div class="dl-buttons flex flex-wrap justify-center gap-3">
    {
      artifacts.map((a) => (
        <a
          class="dl-button inline-flex items-center gap-2 rounded-full border border-(--sl-color-hairline) bg-(--sl-color-bg-sidebar) px-[1.375rem] py-2.5 text-[0.9375rem] font-semibold text-gray-900 no-underline transition-[border-color,transform] duration-200 ease-out hover:-translate-y-px hover:border-[color-mix(in_srgb,var(--color-accent-500)_55%,transparent)] active:translate-y-0 motion-reduce:transition-none motion-reduce:hover:transform-none dark:text-white"
          href={a.href}
        >
          <span class="dl-icon inline-flex text-accent-600 dark:text-accent-200 [&_svg]:size-4" aria-hidden="true" set:html={downloadIcon} />
          {label}
          <span class="dl-arch font-mono text-[0.8125rem] font-medium tracking-[0.15em] uppercase">{a.arch}</span>
        </a>
      ))
    }
  </div>
  <p class="dl-note mt-5 mb-0 text-sm text-gray-700 dark:text-gray-300">
    {note}
    <a
      class="dl-releases ms-1.5 text-accent-600 underline decoration-[color-mix(in_srgb,currentColor_40%,transparent)] underline-offset-[0.18em] transition-[text-decoration-color] duration-150 hover:decoration-current dark:text-accent-200"
      href={RELEASES}
      rel="noopener"
    >
      {releasesText}
    </a>
  </p>
</div>
