  {
    "id": "builtin.corner_dots",
    "display_name": "定位球",
    "builtin": true,
    "is_dynamic": false,
    "defaults": {
      "count": 4,
      "offset": 40.0,
      "radius": 8.0
    },
    "schema": [
      {
        "default": 4,
        "key": "count",
        "label": "点数",
        "options": [
          {
            "label": "4 点（四角）",
            "value": 4
          },
          {
            "label": "6 点（四角+上下中）",
            "value": 6
          },
          {
            "label": "8 点（四角+四边中）",
            "value": 8
          }
