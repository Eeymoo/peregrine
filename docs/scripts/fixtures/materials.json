  {
    "id": "builtin.edge_arrows",
    "display_name": "箭头",
    "builtin": true,
    "is_dynamic": false,
    "defaults": {
      "distance": 60.0,
      "positions_mask": 0,
      "size": 16.0,
      "tail_bottom": 0.0,
