---
/**
 * 首页特性卡片组件
 *
 * 渲染 6 张特性卡片，复用品牌蓝（--sl-color-text-accent，已由 custom.css 映射为 #2563EB）。
 * 卡片数据由首页 MDX 以 `cards` 属性传入，保持组件本身与语言无关。
 */
interface Card {
  title: string;
  details: string;
}

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
---

<div class="feature-grid">
  {
    cards.map((card) => (
      <article class="feature-card">
        <h2>{card.title}</h2>
        <p>{card.details}</p>
      </article>
    ))
  }
</div>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .feature-card {
    border: 1px solid var(--sl-color-hairline);
    border-top: 3px solid var(--sl-color-text-accent);
    border-radius: 0.5rem;
    padding: 1.25rem;
    background: var(--sl-color-bg-sidebar);
  }

  .feature-card h2 {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.5rem;
    color: var(--sl-color-text-accent);
  }

  .feature-card p {
    margin: 0;
    color: var(--sl-color-text);
  }
</style>
