---
/**
 * 落地页 Hero（覆写 Starlight 默认 Hero 组件）
 *
 * 左文右图非对称布局：左侧 eyebrow + 标题 + 副标题 + 双 CTA，右侧真实产品截图
 * （截图由 docs/scripts/capture-screenshots.mjs 产出，主程序 UI 为固定深色主题）。
 *
 * 数据沿用 frontmatter `hero` 字段（title / tagline / actions）。
 * eyebrow 与截图 alt 为组件内置的 locale 字典（Starlight frontmatter schema
 * 会剥离未知键，自定义字段无法透传，故按 Astro.locals.starlightRoute.locale 取词）。
 *
 * 注意：splash 模板中本组件位于 .sl-markdown-content 之外，Tailwind 工具类直接生效；
 * dark: 变体已由 @astrojs/starlight-tailwind 桥接到站点主题开关。
 *
 * 样式为 Tailwind 工具类（twcss-migration change）：入场渐显用 @theme 的
 * animate-rise token + 任意值 delay（D6），reduced-motion 塌缩块保留为豁免 CSS；
 * aukcraft 壳层改造（docs-aukcraft-shell）：截图框零阴影 + hairline 边框（D4，
 * 静态无 hover 浮起）、圆角收紧 ≤4px（D3）、标题 serif-italic 关键词强调（D8，
 * 经 frontmatter title 内嵌 <em> / <em class="serif-zh"> 承载）。
 */
import { LinkButton } from '@astrojs/starlight/components';

const { data, locale } = Astro.locals.starlightRoute.entry
  ? { data: Astro.locals.starlightRoute.entry.data, locale: Astro.locals.starlightRoute.locale }
  : { data: {} as Record<string, never>, locale: 'root' };

/** locale 字典：root 为英文，zh-cn 为简体中文。 */
const STRINGS: Record<string, { eyebrow: string; screenshotAlt: string }> = {
  root: {
    eyebrow: 'Open source · Windows',
    screenshotAlt: 'Peregrine layers editor: multi-layer visual anchors with live preview',
  },
  'zh-cn': {
    eyebrow: '开源 · Windows 平台',
    screenshotAlt: 'Peregrine 图层编辑器：多图层视觉锚点与实时预览',
  },
};
const s = STRINGS[locale] ?? STRINGS.root;

const { title = (data as { title?: string }).title, tagline, actions = [] } =
  (data as { hero?: { title?: string; tagline?: string; actions?: never[] } }).hero ?? {};

/** 入场错峰 delay（motion-safe 下生效）。 */
const COPY_DELAYS = ['[animation-delay:0ms]', '[animation-delay:80ms]', '[animation-delay:160ms]', '[animation-delay:240ms]'];

/** Starlight frontmatter 的 title 可能含 HTML（换行控制），原样渲染。 */
---

<section class="landing-hero not-content py-[clamp(2.5rem,6vw,5rem)] pb-12" data-pagefind-ignore>
  <div class="lh-grid grid items-center gap-10 lg:grid-cols-[5fr_7fr] lg:gap-14">
    <div class="lh-copy flex min-w-0 flex-col gap-5">
      <p class:list={['lh-eyebrow m-0 text-[0.8125rem] font-semibold tracking-[0.16em] text-accent-600 uppercase dark:text-accent-200', 'motion-safe:animate-rise', COPY_DELAYS[0]]}>
        {s.eyebrow}
      </p>
      <h1
        class:list={[
          'lh-title m-0 pb-1 text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.1] font-bold tracking-[-0.02em] text-balance text-gray-900 dark:text-gray-50',
          'motion-safe:animate-rise',
          COPY_DELAYS[1],
        ]}
        set:html={title}
      />
      {
        tagline && (
          <p
            class:list={[
              'lh-tagline m-0 max-w-lg text-[clamp(1rem,1.4vw,1.125rem)] leading-[1.7] text-gray-700 dark:text-gray-300',
              'motion-safe:animate-rise',
              COPY_DELAYS[2],
            ]}
            set:html={tagline}
          />
        )
      }
      {
        actions.length > 0 && (
          <div class:list={['lh-actions mt-2 flex flex-wrap gap-3', 'motion-safe:animate-rise', COPY_DELAYS[3]]}>
            {actions.map(({ attrs = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} {...attrs}>
                {text}
              </LinkButton>
            ))}
          </div>
        )
      }
    </div>

    <div class="lh-visual min-w-0 motion-safe:animate-rise motion-safe:[animation-delay:160ms] motion-safe:[animation-duration:0.7s]" aria-hidden="false">
      <div
        class="lh-frame overflow-hidden rounded border border-(--sl-color-hairline) bg-(--sl-color-bg-sidebar)"
      >
        <div class="lh-frame-bar flex items-center gap-1.5 border-b border-(--sl-color-hairline-light) px-3.5 py-2.5">
          <span class="lh-frame-dot size-2.5 rounded-full bg-(--sl-color-hairline)"></span>
          <span class="lh-frame-dot size-2.5 rounded-full bg-(--sl-color-hairline)"></span>
          <span class="lh-frame-dot size-2.5 rounded-full bg-(--sl-color-hairline)"></span>
        </div>
        <img
          src="/img/screenshots/settings-layers.png"
          alt={s.screenshotAlt}
          width="1600"
          height="1000"
          loading="eager"
          decoding="async"
          class="lh-shot block h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* Starlight LinkButton 形态统一（:global 选择器，豁免清单 D5-3）：
     primary 实心品牌色，secondary 描边，统一为 4px 方形（D3）。 */
  .lh-actions :global(.sl-link-button) {
    border-radius: 4px;
  }

  /* serif-italic 强调词（frontmatter title 中的 <em>）：Newsreader italic；
     中文关键词用 .serif-zh 系统 serif 栈（D8）。descender（y/g 等）由标题
     leading-[1.08] + pb-1 预留空间防裁剪。 */
  .lh-title :global(em) {
    font-family: 'Newsreader Variable', 'Newsreader', serif;
    font-style: italic;
    font-weight: 500;
  }

  .lh-title :global(em.serif-zh) {
    font-family: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
    font-style: normal;
  }
</style>
