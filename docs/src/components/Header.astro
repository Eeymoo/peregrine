---
/**
 * Starlight Header 覆写（本站点仅有的第二个组件覆写，第一个是 Hero）。
 *
 * 目的：在 site title 右侧插入顶部导航链接（AukCraft ↗ / Docs / Download）。
 * 除导航区（.header-nav）外完全复制 @astrojs/starlight@0.41 默认 Header 结构，
 * 保持覆盖物最小化；Starlight 升级时需对照默认 Header.astro 复核本文件。
 *
 * 桌面端显示（md 断点以上），窄屏隐藏——移动端入口由 sidebar 顶层 link 项承担。
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import { lucideIcon } from '../lib/icons';
import { localeBase } from '../lib/locale';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

// 双语导航文案与路径：locale 为 URL base（root locale 为 undefined，zh-cn 为 'zh-cn'）。
// localeBase 内部处理了 llms.txt 等非 Starlight 渲染上下文（starlightRoute 未就绪会抛错）。
const locale = localeBase(Astro);
const prefix = locale ? `/${locale}` : '';
const navLinks = [
	{ label: 'AukCraft', href: 'https://www.aukcraft.org/', external: true },
	{ label: locale ? '文档' : 'Docs', href: `${prefix}/guide/intro`, external: false },
	{ label: locale ? '下载' : 'Download', href: `${prefix}/download`, external: false },
];
const externalIcon = lucideIcon('ExternalLink');
// 现代化项 1：当前页 active 态。路由判定最小化——pathname 去掉可选 .html 后缀与尾斜杠后前缀比较。
// 注意 build.format: 'file' 下 Astro.url.pathname 形如 /guide/usage.html，必须先剥 .html。
const normalize = (p: string) => p.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const pathname = normalize(Astro.url.pathname);
const isActive = (href: string) => {
	if (href.startsWith('http')) return false;
	const h = normalize(href);
	// 子路径判断按首段（如 /guide）而非整链（/guide/intro），否则 guide 下其他页无 active 态。
	const firstSeg = h.match(/^\/[^/]+/)?.[0] ?? h;
	return pathname === h || pathname === h + '/index' || pathname.startsWith(firstSeg + '/');
};
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<nav class="header-nav hidden items-center gap-5 ms-6 md:flex" aria-label="Top">
			{
				navLinks.map((l) => {
					const active = isActive(l.href);
					return (
						<a
							class:list={[
								'header-nav-link group relative inline-flex items-center gap-1 text-[0.9375rem] font-medium whitespace-nowrap no-underline transition-colors duration-200 ease-out',
								'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-600 dark:focus-visible:outline-accent-200',
								active
									? 'is-active text-gray-900 dark:text-white'
									: 'text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white',
							]}
							href={l.href}
							{...(active ? { 'aria-current': 'page' } : {})}
							{...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
						>
							{l.label}
							{l.external && (
								<span class="header-nav-icon inline-flex [&_svg]:size-3.5" aria-hidden="true" set:html={externalIcon} />
							)}
							{/* 现代化项 2：hover 下划线 scaleX 动画；active 态常显（现代化项 1 的指示）。reduced-motion 塌缩 */}
							<span
								class:list={[
									'pointer-events-none absolute inset-x-0 -bottom-0.5 h-px origin-left transition-transform duration-200 ease-out motion-reduce:transition-none',
									active
										? 'scale-x-100 bg-accent-600 dark:bg-accent-200'
										: 'scale-x-0 bg-gray-400 group-hover:scale-x-100 dark:bg-gray-500',
								]}
								aria-hidden="true"
							/>
						</a>
					);
				})
			}
		</nav>
	</div>
	<div class="sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
        /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest  */
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					/* 2 (search box): all free space that is available. */
					1fr
					/* 3 (right items): use the space that these need. */
					auto;
				align-content: center;
			}
		}
	}
</style>
