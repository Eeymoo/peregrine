---
/**
 * 特性网格（落地页区块）
 *
 * 非等宽网格：首卡跨两列形成视觉锚点，避免"六张一样的卡"的套路感。
 * 图标为 lucide 系 1.5px 线稿（lucide-static 构建时内联，与主应用 lucide-react 同源数据）。
 * 文案由 MDX 以 props 传入，组件与语言无关。
 */
import { lucideIcon } from '../../lib/icons';

interface Feature {
  title: string;
  details: string;
  icon: 'overlay' | 'follow' | 'styles' | 'image' | 'preview' | 'hotreload';
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;

const ICONS: Record<Feature['icon'], string> = {
  // 堆叠窗口（透明覆盖层）
  overlay: lucideIcon('Layers'),
  // 定位跟随（目标窗口跟随）
  follow: lucideIcon('LocateFixed'),
  // 准星样式（多种锚点样式）
  styles: lucideIcon('Crosshair'),
  // 图片（自定义 PNG 贴图）
  image: lucideIcon('Image'),
  // 眼睛（实时设置与预览）
  preview: lucideIcon('Eye'),
  // 环形箭头（热重载配置）
  hotreload: lucideIcon('RefreshCw'),
};
---

<div class="fg-grid not-content" data-pagefind-ignore>
  {
    features.map((f, i) => (
      <article class:list={['fg-card', i === 0 && 'fg-card-wide']}>
        <span class="fg-icon" aria-hidden="true" set:html={ICONS[f.icon]} />
        <h3 class="fg-title">{f.title}</h3>
        <p class="fg-details">{f.details}</p>
      </article>
    ))
  }
</div>

<style>
  .fg-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .fg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .fg-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    /* 6 卡节奏：首卡 2 列宽 + 3 卡 → 第二行 2 卡各 2 列宽。 */
    .fg-card-wide {
      grid-column: span 2;
    }
    .fg-card:nth-child(5),
    .fg-card:nth-child(6) {
      grid-column: span 2;
    }
  }

  .fg-card {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    padding: 1.375rem;
    background: var(--sl-color-bg-sidebar);
    transition: border-color 200ms ease;
  }

  .fg-card:hover {
    border-color: color-mix(in srgb, var(--color-accent-500) 45%, transparent);
  }

  .fg-icon {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--color-accent-500) 12%, transparent);
  }

  .fg-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .fg-title {
    margin: 0.875rem 0 0.375rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
  }

  .fg-details {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .fg-card {
      transition: none;
    }
  }
</style>
