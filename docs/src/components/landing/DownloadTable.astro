---
/**
 * 下载页表格组件（决策 D1/D2：构建时 API 数据 + 通道/加速/架构筛选）。
 *
 * - 数据由 props 注入（releases）；未注入时组件在构建时自行拉取 GitHub Releases API。
 * - API 失败（releases 为 null）降级为「查看 GitHub Releases」外链，页面始终可渲染。
 * - 通道切换：稳定版 / 预发布版（无对应 release 的通道不渲染）。
 * - 加速/直连切换：仅 showProxy=true（zh-cn）时渲染，内置多个 gh-proxy 候选。
 * - 交互为 vanilla <script>，不引入 React island。
 * - 图标全部来自 lucide-static（与主应用 lucide-react 同源），不手写 SVG。
 *
 * 样式为 Tailwind 工具类（twcss-migration change）：
 * - is-active 为 JS 状态钩子类（D5-2），其视觉态以 aria-pressed="true" 属性选择器
 *   工具类承载（与 JS 同步维护的 ARIA 属性单一事实源），无残留手写态样式；
 * - is-hidden 保留为语义钩子 + hidden 工具类；
 * - 现代化项：筛选/通道按钮 hover 边框过渡细化为 border-color+color+background-color
 *   三通道 200ms，active 态背景淡染加重（14% → 16%）提升选中可读性。
 */
import type { ReleasesData, ReleaseInfo } from '../../lib/releases';
import { fetchReleases } from '../../lib/releases';
import { lucideIcon } from '../../lib/icons';
import FlightLine from '../FlightLine.astro';

/** 页面文案（组件与语言无关，全部由 MDX 注入）。 */
export interface DownloadTableLabels {
  /** 通道名：稳定版。 */
  stable: string;
  /** 通道名：预发布版。 */
  prerelease: string;
  /** 架构筛选：全部。 */
  allArch: string;
  /** 加速通道标签（如 "GitHub 加速"）。 */
  accelerate: string;
  /** 直连选项标签。 */
  direct: string;
  /** 表头：操作系统。 */
  colOs: string;
  /** 表头：硬件架构。 */
  colArch: string;
  /** 表头：安装包（NSIS exe）。 */
  colSetup: string;
  /** 表头：便携版（zip）。 */
  colZip: string;
  /** 表头：注意事项。 */
  colNote: string;
  /** 注意事项列正文（三行共用）。 */
  note: string;
  /** 下载链接文字（如 "下载" / "Download"）。 */
  download: string;
  /** 「查看更多版本」按钮文字。 */
  moreReleases: string;
  /** 降级态文案（API 不可用时的说明）。 */
  fallbackText: string;
  /** 降级态外链文字（如 "查看 GitHub Releases"）。 */
  fallbackLink: string;
}

interface Props {
  /** 构建时注入的 release 数据；缺省时组件自行拉取；null 表示 API 不可用（降级）。 */
  releases?: ReleasesData | null;
  /** 是否渲染「GitHub 加速」通道（仅 zh-cn 传 true）。 */
  showProxy?: boolean;
  labels: DownloadTableLabels;
}

const { showProxy = false, labels } = Astro.props;
// props 未注入（undefined）时构建时拉取；显式传 null 走降级路径。
const releases = Astro.props.releases === undefined ? await fetchReleases() : Astro.props.releases;

const RELEASES_PAGE = 'https://github.com/Eeymoo/peregrine/releases';

/** gh-proxy 候选前缀（公益代理存活期短，内置多个供用户切换，决策 D2）。 */
const PROXY_PREFIXES = ['https://ghfast.top/', 'https://gh-proxy.com/', 'https://ghproxy.net/'];

const ARCHES = [
  { key: 'x64', label: 'x64' },
  { key: 'x86', label: 'x86' },
  { key: 'arm64', label: 'ARM64' },
] as const;

const channels: { key: 'stable' | 'prerelease'; label: string; info: ReleaseInfo }[] = [];
if (releases?.stable) channels.push({ key: 'stable', label: labels.stable, info: releases.stable });
if (releases?.prerelease) channels.push({ key: 'prerelease', label: labels.prerelease, info: releases.prerelease });

const downloadIcon = lucideIcon('Download');
const externalIcon = lucideIcon('ExternalLink');

/** 通道/筛选按钮共用工具类串（方形描边 4px + hover/active 态，active 由 aria-pressed 属性选择器承载）。 */
const PILL =
  'inline-flex items-center gap-1.5 rounded border border-(--sl-color-hairline) bg-transparent px-3.5 py-1.5 ' +
  'text-sm font-medium text-gray-700 transition-[border-color,color,background-color] duration-200 ease-out ' +
  'hover:border-[color-mix(in_srgb,var(--color-accent-500)_55%,transparent)] hover:text-gray-900 ' +
  'aria-pressed:border-accent-600 aria-pressed:bg-[color-mix(in_srgb,var(--color-accent-500)_16%,transparent)] aria-pressed:text-gray-900 ' +
  'motion-reduce:transition-none ' +
  'dark:text-gray-300 dark:hover:text-white dark:aria-pressed:border-accent-200 dark:aria-pressed:text-white';
---

{
  releases && channels.length > 0 ? (
    <div class="download-table not-content" data-pagefind-ignore>
      <div class="dt-controls mb-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        {channels.length > 0 && (
          <div class="dt-group inline-flex flex-wrap gap-1.5" role="group" aria-label="channel">
            {channels.map((c, i) => (
              <button
                type="button"
                class:list={['dt-tab', PILL, i === 0 && 'is-active']}
                data-channel={c.key}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {c.label}
                <span class="dt-tag text-xs text-accent-600 dark:text-accent-200">{c.info.tag}</span>
              </button>
            ))}
          </div>
        )}
        <div class="dt-group inline-flex flex-wrap gap-1.5" role="group" aria-label="arch">
          <button type="button" class:list={['dt-filter', 'is-active', PILL]} data-arch="all" aria-pressed="true">
            {labels.allArch}
          </button>
          {ARCHES.map((a) => (
            <button type="button" class:list={['dt-filter', PILL]} data-arch={a.key} aria-pressed="false">
              {a.label}
            </button>
          ))}
        </div>
        {showProxy && (
          <label class="dt-proxy inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
            <span class="dt-proxy-label">{labels.accelerate}</span>
            <select class="dt-proxy-select rounded border border-(--sl-color-hairline) bg-(--sl-color-bg-sidebar) px-2.5 py-1.5 text-sm text-gray-900 dark:text-gray-50">
              <option value="">{labels.direct}</option>
              {PROXY_PREFIXES.map((p) => (
                <option value={p}>{new URL(p).host}</option>
              ))}
            </select>
          </label>
        )}
      </div>

      {channels.map((c, i) => (
        <div class:list={['dt-channel', i !== 0 && 'is-hidden hidden']} data-channel={c.key}>
          <table class="w-full">
            <thead>
              <tr>
                <th>{labels.colOs}</th>
                <th>{labels.colArch}</th>
                <th>{labels.colSetup}</th>
                <th>{labels.colZip}</th>
                <th>{labels.colNote}</th>
              </tr>
            </thead>
            <tbody>
              {ARCHES.map((a) => {
                const assets = c.info.arches[a.key];
                if (!assets.setup && !assets.zip) return null;
                return (
                  <tr data-arch={a.key}>
                    <td>Windows 10/11</td>
                    <td>{a.label}</td>
                    <td>
                      {assets.setup ? (
                        <a
                          class="dt-dl inline-flex items-center gap-1.5 font-medium whitespace-nowrap text-accent-600 no-underline hover:underline hover:underline-offset-[0.18em] dark:text-accent-200"
                          href={assets.setup}
                          data-direct={assets.setup}
                          rel="noopener"
                        >
                          <span class="dt-icon inline-flex [&_svg]:size-4" aria-hidden="true" set:html={downloadIcon} />
                          {labels.download}
                        </a>
                      ) : (
                        '—'
                      )}
                    </td>
                    <td>
                      {assets.zip ? (
                        <a
                          class="dt-dl inline-flex items-center gap-1.5 font-medium whitespace-nowrap text-accent-600 no-underline hover:underline hover:underline-offset-[0.18em] dark:text-accent-200"
                          href={assets.zip}
                          data-direct={assets.zip}
                          rel="noopener"
                        >
                          <span class="dt-icon inline-flex [&_svg]:size-4" aria-hidden="true" set:html={downloadIcon} />
                          {labels.download}
                        </a>
                      ) : (
                        '—'
                      )}
                    </td>
                    <td class="dt-note text-[0.8125rem] text-gray-500 dark:text-gray-400">{labels.note}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ))}

      <p class="dt-more mt-5 mb-0 text-center">
        <a
          class="dt-more-link flight inline-flex items-center gap-2 rounded border border-(--sl-color-hairline) bg-(--sl-color-bg-sidebar) px-[1.375rem] py-2.5 text-[0.9375rem] font-semibold text-gray-900 no-underline dark:text-gray-50"
          href={RELEASES_PAGE}
          target="_blank"
          rel="noopener"
        >
          <span class="dt-icon inline-flex text-accent-600 dark:text-accent-400 [&_svg]:size-4" aria-hidden="true" set:html={externalIcon} />
          {labels.moreReleases}
          <FlightLine />
        </a>
      </p>
    </div>
  ) : (
    <div class="download-table dt-fallback not-content" data-pagefind-ignore>
      <p class="text-gray-700 dark:text-gray-300">{labels.fallbackText}</p>
      <p class="dt-more mt-5 mb-0 text-center">
        <a
          class="dt-more-link flight inline-flex items-center gap-2 rounded border border-(--sl-color-hairline) bg-(--sl-color-bg-sidebar) px-[1.375rem] py-2.5 text-[0.9375rem] font-semibold text-gray-900 no-underline dark:text-gray-50"
          href={RELEASES_PAGE}
          target="_blank"
          rel="noopener"
        >
          <span class="dt-icon inline-flex text-accent-600 dark:text-accent-400 [&_svg]:size-4" aria-hidden="true" set:html={externalIcon} />
          {labels.fallbackLink}
          <FlightLine />
        </a>
      </p>
    </div>
  )
}

<script>
  // 下载页交互：通道切换 / 架构筛选 / 加速前缀（vanilla，无框架依赖）。
  document.querySelectorAll<HTMLElement>('.download-table').forEach((root) => {
    // 通道切换：显示对应 data-channel 区块。
    root.querySelectorAll<HTMLButtonElement>('.dt-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('.dt-tab').forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });
        root.querySelectorAll<HTMLElement>('.dt-channel').forEach((sec) => {
          const hide = sec.dataset.channel !== btn.dataset.channel;
          sec.classList.toggle('is-hidden', hide);
          sec.classList.toggle('hidden', hide);
        });
      });
    });

    // 架构筛选：只显示对应 data-arch 行。
    root.querySelectorAll<HTMLButtonElement>('.dt-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('.dt-filter').forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', String(b === btn));
        });
        const arch = btn.dataset.arch;
        root.querySelectorAll<HTMLElement>('tbody tr[data-arch]').forEach((row) => {
          const hide = arch !== 'all' && row.dataset.arch !== arch;
          row.classList.toggle('is-hidden', hide);
          row.classList.toggle('hidden', hide);
        });
      });
    });

    // 加速/直连：重写所有下载链接 href（prefix + 原始 URL）。
    const select = root.querySelector<HTMLSelectElement>('.dt-proxy-select');
    select?.addEventListener('change', () => {
      const prefix = select.value;
      root.querySelectorAll<HTMLAnchorElement>('.dt-dl').forEach((a) => {
        const direct = a.dataset.direct;
        if (direct) a.href = prefix + direct;
      });
    });
  });
</script>
