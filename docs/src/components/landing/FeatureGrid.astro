---
/**
 * 特性网格（落地页区块）
 *
 * 规整 2×3 网格：六卡两行三列，hairline 分隔线衬出网格（gap-px + 容器
 * hairline 底色）。图标为 lucide 系 1.5px 线稿（lucide-static 构建时内联，
 * 与主应用 lucide-react 同源数据）。文案由 MDX 以 props 传入，组件与语言无关。
 *
 * 样式为 Tailwind 工具类（twcss-migration change）：
 * - hairline 分隔网格：gap-px + 网格容器 hairline 底色衬出分隔线（D10 签名元素 3），卡片边框取消；
 * - 现代化项：图标品牌色淡染容器（accent 12% 底）+ 卡片 hover 底色微反馈（motion-reduce 塌缩）。
 */
import { lucideIcon } from '../../lib/icons';

interface Feature {
  title: string;
  details: string;
  icon: 'overlay' | 'follow' | 'styles' | 'image' | 'preview' | 'hotreload';
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;

const ICONS: Record<Feature['icon'], string> = {
  // 堆叠窗口（透明覆盖层）
  overlay: lucideIcon('Layers'),
  // 定位跟随（目标窗口跟随）
  follow: lucideIcon('LocateFixed'),
  // 准星样式（多种锚点样式）
  styles: lucideIcon('Crosshair'),
  // 图片（自定义 PNG 贴图）
  image: lucideIcon('Image'),
  // 眼睛（实时设置与预览）
  preview: lucideIcon('Eye'),
  // 环形箭头（热重载配置）
  hotreload: lucideIcon('RefreshCw'),
};
---

<div
  class="fg-grid not-content grid grid-cols-1 gap-px overflow-hidden rounded bg-(--sl-color-hairline-light) min-[48rem]:grid-cols-2 lg:grid-cols-3"
  data-pagefind-ignore
>
  {
    features.map((f) => (
      <article class="fg-card bg-white p-[1.375rem] transition-colors duration-200 ease-out motion-reduce:transition-none hover:bg-gray-50 dark:bg-gray-900 dark:hover:bg-gray-800">
        <span
          class="fg-icon inline-flex rounded bg-[color-mix(in_srgb,var(--color-accent-500)_12%,transparent)] p-2 text-accent-600 dark:text-accent-200 [&_svg]:size-5"
          aria-hidden="true"
          set:html={ICONS[f.icon]}
        />
        <h3 class="fg-title mt-3.5 mb-1.5 text-base leading-[1.4] font-semibold text-gray-900 dark:text-gray-50">{f.title}</h3>
        <p class="fg-details m-0 text-sm leading-[1.65] text-gray-700 dark:text-gray-300">{f.details}</p>
      </article>
    ))
  }
</div>
