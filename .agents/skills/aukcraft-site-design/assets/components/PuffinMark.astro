---
/**
 * PuffinMark — 海鹦吉祥物 / logo（深色主题内联版本）。
 * 与 public/favicon.svg 同一路径数据，颜色经 .pm-* class 映射到暗色底。
 * 换色：只改 global.css 中对应 .pm-* 的 fill 与 stroke。
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 1080 1080"
  class:list={['puffin-mark', className]}
  role="img"
  aria-label="aukcraft puffin mascot"
>
  <slot />
  <g class="puffin-mark__body">
    <g id="pm-foot">
      <path class="pm-feather" d="M501,801 L517,866 L645,866 L649,843 L556,844 L546,801 Z"></path>
    </g>
    <g id="pm-belly">
      <defs>
